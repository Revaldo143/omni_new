# Copy this file to ".env" and fill in your values.
# Get a FREE Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# --- Jarvis 2.0: LLM provider ---
# gemini = Google AI Studio (default). openai = any OpenAI-compatible
# endpoint: OpenAI, Groq, OpenRouter, DeepSeek, Ollama...
LLM_PROVIDER=gemini

# Optional
AGENT_NAME=Jarvis
OMNI_FLASH_MODEL=gemini-3.5-flash
# Free quota is PER MODEL per PROJECT (flash free tier = 20 requests/day).
# If it runs out: switch OMNI_FLASH_MODEL to a fresh bucket
# (gemini-3-flash-preview), or set LLM_PROVIDER=openai below.
OMNI_PRO_MODEL=gemini-3.1-pro-preview

# OpenAI-compatible provider (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
#OPENAI_SMART_MODEL=gpt-4o

# Daily model-call budget. The brain counts every call and stops with an
# honest message instead of dying mid-task. 18 stays under the free 20.
OMNI_DAILY_BUDGET=18

# Optional: E2B cloud sandbox (free tier: https://e2b.dev)
E2B_API_KEY=

# Optional: FalkorDB graph memory; without it a built-in SQLite graph is used
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Phase 3: Telegram bot (free — create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
# The bot tells you this ID on first message; then only you are served
OMNI_OWNER_CHAT_ID=

# Phase 4: morning brief time (IST, 24h) — scheduler/bot sends it daily
OMNI_BRIEF_TIME=08:00

# Phase 5: voice (Telegram voice notes — hear + speak)
OMNI_TTS_MODEL=gemini-3.8-flash-tts
OMNI_TTS_VOICE=Kore
OMNI_VOICE_REPLY=1
